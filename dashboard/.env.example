# Jeton secret de la R4 (le même dans arduino_secrets.h) : générer avec  openssl rand -hex 24
PITBOX_TOKEN=change-moi
# ":80" pour du HTTP sur l'IP, ou "51-75-12-34.sslip.io" (l'IP du VPS avec des tirets) pour du HTTPS automatique
PITBOX_ADRESSE=:80
# Sauvegarde automatique de la base dans ./sauvegardes : toutes les N heures, en gardant les M dernières
PITBOX_SAUVEGARDE_HEURES=6
PITBOX_SAUVEGARDE_GARDER=40
